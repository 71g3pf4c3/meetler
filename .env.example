# Скопируй в .env и заполни. Ключи генерь через ./scripts/gen-keys.sh

# Публичный домен nginx. Должен указывать A/AAAA на этот хост.
SITE_DOMAIN=meet.example.com

# Домен встроенного TURN. Обычно = SITE_DOMAIN (один серт на оба) или поддомен.
TURN_DOMAIN=meet.example.com

# LiveKit API keypair. Генерируется скриптом. ОБА значения должны совпадать
# в livekit.yaml (scripts/render.sh) и в окружении API.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# TLS-серт и ключ для nginx и TURN: certs/turn.crt и certs/turn.key.
# Встроенный TURN включай после установки серта.
TURN_ENABLED=false

# Срок жизни анонимного room-токена.
TOKEN_TTL=6h

# Лимит участников на комнату (навязывается при создании комнаты).
ROOM_MAX_PARTICIPANTS=30

# Тихие (protected) палаты, csv: всегда в списке, не закрываются голосованием,
# tgbridge в них не публикует. Одинаково для api и tgbridge.
PROTECTED_ROOMS=tishina

# --- Telegram-мост (tgbridge), опционально ---
# Поднимается через: docker compose --profile telegram up -d
TELEGRAM_BOT_TOKEN=
# URL livekit для бота (host-network → localhost).
LIVEKIT_URL=ws://127.0.0.1:7880
# Палата по умолчанию, если в сообщении не указана #палата и нет /palata.
DEFAULT_PALATA=telegram
# Персист привязок /palata (JSON). Пусто = в памяти (сброс при рестарте).
# Для docker смонтируй volume и укажи путь, напр. /data/palatas.json.
PALATA_STORE_FILE=
# TTS озвучка текста (@бот/#палата). Путь к piper .onnx модели внутри контейнера.
# Пусто = TTS выключен (медиа всё равно работает). Модель монтируй через override.
PIPER_MODEL=
