# Референс env-файла для EnvironmentFile NixOS-модуля (services.meetler).
# См. nix/module.nix: services.meetler.environmentFiles и
# services.meetler.telegram.environmentFile. Имена LIVEKIT_API_KEY/SECRET
# должны совпадать с services.livekit.keyFile.

# LiveKit API keypair (должен совпадать с key_file для services.livekit).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Лимит участников на комнату (навязывается при создании комнаты).
ROOM_MAX_PARTICIPANTS=30

# Тихие (protected) палаты, csv: всегда в списке, не закрываются голосованием,
# tgbridge в них не публикует. Одинаково для api и tgbridge.
PROTECTED_ROOMS=tishina

# --- Telegram-мост (tgbridge), опционально ---
TELEGRAM_BOT_TOKEN=
# Палата по умолчанию, если в сообщении не указана #палата и нет /palata.
DEFAULT_PALATA=telegram
# Персист привязок /palata (JSON). Пусто = в памяти (сброс при рестарте).
# В NixOS: /var/lib/meetler-tgbridge/palatas.json (StateDirectory сервиса).
PALATA_STORE_FILE=
# TTS озвучка текста (@бот/#палата). Путь к piper .onnx модели на хосте.
# Пусто = TTS выключен (медиа всё равно работает).
PIPER_MODEL=
