# Dev-only: HTTP на :8088 без TLS. localhost — secure context, getUserMedia работает.
# НЕ для прода (нет TLS, недоступно другим устройствам в сети).
{
	auto_https off
}

:8088 {
	encode gzip

	handle /api/* {
		reverse_proxy token-svc:8080
	}
	handle /rtc* {
		reverse_proxy host.docker.internal:7880
	}
	handle /twirp* {
		reverse_proxy host.docker.internal:7880
	}
	@assets path /vendor/* /logo.png /avatar.jpg /dav/* /welcome.mp3 /priem.jpg /jail.jpg
	handle @assets {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv/web
		file_server
	}
	handle {
		header Cache-Control "no-cache"
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
