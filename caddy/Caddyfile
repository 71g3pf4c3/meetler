# Caddy: TLS (авто-ACME) для сигналинга, статики клиента и token API.
# Медиа (UDP) и TURN/TLS идут МИМО Caddy напрямую на host — здесь только HTTP/WS.

{$SITE_DOMAIN} {
	encode zstd gzip

	# token API → Go-сервис в internal-сети
	handle /api/* {
		reverse_proxy token-svc:8080
	}

	# LiveKit signaling (wss) + RoomService. livekit в host-network → host-gateway:7880.
	# Caddy проксирует WebSocket upgrade прозрачно.
	handle /rtc* {
		reverse_proxy host.docker.internal:7880
	}
	handle /twirp* {
		reverse_proxy host.docker.internal:7880
	}

	# vendor/ассеты — immutable, долгий кэш (livekit-client, logo, avatar, mp3).
	@assets path /vendor/* /logo.png /avatar.jpg /dav/* /welcome.mp3 /priem.jpg /jail.jpg
	handle @assets {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv/web
		file_server
	}

	# статика клиента (app.js/index.html меняются → без кэша)
	handle {
		header Cache-Control "no-cache"
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
