map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${SITE_DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${SITE_DOMAIN};
    ssl_certificate /certs/turn.crt;
    ssl_certificate_key /certs/turn.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    include /etc/nginx/meetler-locations.conf;
}
